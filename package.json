{
  "name": "devdesk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.17.0",
    "pnpm": ">=10.15.0"
  },
  "scripts": {
    "check:rust": "cargo clippy --all-targets --all-features -- -D warnings",
    "check:fmt:rust": "cargo fmt --all -- --check",
    "check:types": "pnpm -r --filter \"./packages/*\" run typecheck",
    "check:layering": "depcruise --config configs/dependency-cruiser/.dependency-cruiser.cjs packages",
    "check:cfg": "node scripts/lint-cfg-usage.mjs",
    "check": "pnpm run check:fmt:rust && pnpm run check:rust && pnpm run check:types && pnpm run check:layering && pnpm run check:cfg"
  },
  "devDependencies": {
    "dependency-cruiser": "17.0.1",
    "typescript": "5.9.3"
  }
}
