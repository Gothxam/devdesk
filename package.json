{
  "name": "devdesk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.17.0",
    "pnpm": ">=10.15.0"
  },
  "scripts": {
    "check:rust": "cargo clippy --all-targets --all-features -- -D warnings",
    "check:fmt:rust": "cargo fmt --all -- --check",
    "check:types": "pnpm -r --filter \"./packages/*\" run typecheck",
    "check": "pnpm run check:fmt:rust && pnpm run check:rust && pnpm run check:types"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
